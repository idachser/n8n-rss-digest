    {
      "id": "ca9b85f6-4c06-5804-ae82-a0e5f3a1f8a5",
      "name": "Check duplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        0
      ],
      "parameters": {
        "jsCode": "const { chatId, url } = $('Parse command').first().json;\n// Only scheme and host are case-insensitive; paths and queries are not.\nconst norm = (u) => String(u).trim().replace(/\\/+$/, '').replace(/^[a-z]+:\\/\\/[^/?#]+/i, (h) => h.toLowerCase());\nconst duplicate = $input.all().some((i) => i.json.url && norm(i.json.url) === norm(url));\n\nreturn [{\n  json: {\n    chatId,\n    url,\n    duplicate,\n    text: duplicate ? `Diese Quelle ist bereits in der Liste: ${url}` : '',\n  },\n}];\n"
      }
    },
    {
      "id": "7987039c-cafa-57cf-a922-ad5add564d73",
      "name": "Is duplicate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "5d1c7e1f-20f1-5484-ade1-c33d6f7dc4d0",
              "leftValue": "={{ $json.duplicate }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "bb642e64-2f54-50df-a227-d4eaf7559693",
      "name": "Try feed",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.2,
      "position": [
        1340,
        100
      ],
      "parameters": {
        "url": "={{ $json.url }}",
