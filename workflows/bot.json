    {
      "id": "b75659bf-e515-5145-ad7f-9059ffae1cd9",
      "name": "Format list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        500
      ],
      "parameters": {
        "jsCode": "const { chatId } = $('Parse command').first().json;\nconst rows = $input.all()\n  .map((i) => i.json)\n  .filter((r) => r.url)\n  .sort((a, b) => a.id - b.id);\n\nconst text = rows.length\n  ? ['Quellen:', ...rows.map((r, i) => `${i + 1}. ${r.title || ''}\\n${r.url}`)].join('\\n')\n  : 'Noch keine Quellen. Hinzufügen: /add https://example.com/rss';\n\nreturn [{ json: { chatId, text } }];\n"
      }
    },
