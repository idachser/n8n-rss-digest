    {
      "id": "f28bde5f-e51c-5b9a-a947-639b4a2c4a01",
      "name": "Resolve source",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "jsCode": "const { chatId, arg } = $('Parse command').first().json;\n// Only scheme and host are case-insensitive; paths and queries are not.\nconst norm = (u) => String(u).trim().replace(/\\/+$/, '').replace(/^[a-z]+:\\/\\/[^/?#]+/i, (h) => h.toLowerCase());\nconst rows = $input.all()\n  .map((i) => i.json)\n  .filter((r) => r.url)\n  .sort((a, b) => a.id - b.id);\n\nconst target = /^\\d+$/.test(arg)\n  ? rows[Number(arg) - 1]\n  : rows.find((r) => norm(r.url) === norm(arg));\n\nif (!target) {\n  return [{ json: { found: false, chatId, text: `Quelle „${arg}“ nicht gefunden. Siehe /list` } }];\n}\nreturn [{ json: { found: true, chatId, url: target.url, title: target.title || target.url } }];\n"
      }
