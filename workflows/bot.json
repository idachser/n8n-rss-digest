        "numberOutputs": 4,
        "output": "={{ $json.route }}"
      }
    },
    {
      "id": "c36c98f9-efbf-5aa6-ae2f-dbd0aca51a55",
      "name": "Get sources (add)",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
