    {
      "id": "6d6f8e4f-0cc3-53bd-a179-555473a2f941",
      "name": "Check feed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        100
      ],
      "parameters": {
        "jsCode": "const { chatId, url } = $('Check duplicate').first().json;\nconst items = $input.all().map((i) => i.json);\nconst entries = items.filter((j) => j.title || j.link);\n\nif (entries.length === 0) {\n  const reason = items.find((j) => j.error)?.error || 'der Feed hat keine Einträge oder ist kein RSS/Atom';\n  return [{ json: { ok: false, chatId, text: `Feed konnte nicht gelesen werden: ${url}\\n${reason}` } }];\n}\n\n// The Code node sandbox has no global URL constructor.\nconst title = (url.match(/^https?:\\/\\/(?:www\\.|rss\\.|feeds?\\.)?([^/:?#]+)/i) || [])[1] || url;\n\nreturn [{ json: { ok: true, chatId, url, title, count: entries.length } }];\n"
      }
    },
